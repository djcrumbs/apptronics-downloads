<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  IgnorableNamespaces="mp uap uap3 uap5">

  <Identity
    Name="AppTronicsGameStudios.NeonBreaker"
    Publisher="CN=Apptronics Game Studios"
    Version="1.0.0.0"
    ProcessorArchitecture="neutral" />

  <mp:PhoneIdentity
    PhoneProductId="00000000-0000-0000-0000-000000000000"
    PhonePublisherId="00000000-0000-0000-0000-000000000000" />

  <Properties>
    <DisplayName>Neon Breaker</DisplayName>
    <PublisherDisplayName>Apptronics Game Studios</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Smash glowing bricks with precision in this neon arcade brick-breaker. Features the signature Plasma Chain mechanic — chain 4 hits in 1.1 seconds to ignite plasma mode across all balls.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Universal" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-GB" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="$targetnametoken$.exe"
      EntryPoint="$targetentrypoint$">

      <uap:VisualElements
        DisplayName="Neon Breaker"
        Description="Neon arcade brick-breaker with Plasma Chain mechanics"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        BackgroundColor="transparent">

        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          ShortName="Neon Breaker">
          <uap:TileUpdate Recurrency="HalfHour" UriTemplate=""/>
        </uap:DefaultTile>

        <uap:SplashScreen Image="Assets\SplashScreen.png" BackgroundColor="#000508" />

        <uap:LockScreen Notification="badge" BadgeLogo="Assets\BadgeLogo.png"/>

      </uap:VisualElements>

      <!-- PWA entry point — generated by PWABuilder -->
      <uap3:AppExecutionAlias ExecutionType="hostRuntime">
        <uap5:ExecutionAlias Alias="NeonBreaker.exe" />
      </uap3:AppExecutionAlias>

    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <!-- internetClient required for Microsoft Advertising SDK ad requests -->
  </Capabilities>

</Package>
